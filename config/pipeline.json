{
  "pipelineVersion": 5,
  "projectSchemaVersion": 1,
  "languageDefault": "de",
  "aspectRatio": "16:9",
  "fps": 30,
  "resolution": {
    "width": 1920,
    "height": 1080
  },
  "coverPolicy": {
    "firstSceneIsCover": true,
    "coverImageNumber": 1,
    "coverCandidateCount": 3,
    "autoSelectWinner": false,
    "selectionAuthority": "user",
    "userSelectionRequired": true,
    "hardStopAfterCoverCandidates": true,
    "continueBeforeUserSelectionForbidden": true,
    "winnerBecomesFirstSceneAndThumbnail": true,
    "deleteLosingCandidates": true,
    "temporaryCandidateNames": [
      "TEMP_COVER_A.png",
      "TEMP_COVER_B.png",
      "TEMP_COVER_C.png"
    ],
    "separateThumbnailForbidden": true
  },
  "imagePolicy": {
    "fixedImageCountForbidden": true,
    "oneImageOneVisualPurpose": true,
    "targetAverageHoldSeconds": [
      4.5,
      7.5
    ],
    "reviewAboveSeconds": 9,
    "preferSplitAboveSeconds": 11,
    "hardMaximumSeconds": 16,
    "minimumUsefulHoldSeconds": 2.5,
    "generationBatchSize": 5,
    "maxConcurrentGenerations": 5,
    "nonCoverGenerationCount": 1,
    "useImageReferences": false,
    "consistencySource": "config/visual-policy.json + vollständiger individueller Textprompt pro Bild",
    "finalImageDirectory": "00-bildprompts/images",
    "finalFolderMustBeFlat": true,
    "finalFolderOnlyNumberedImages": true,
    "nonCoverAlternatesForbidden": true,
    "referenceMode": "none",
    "generatedImageReferenceForbidden": true,
    "oneBatchPerAgentTurn": true,
    "hardStopAfterEachBatch": true,
    "userContinueRequiredBetweenBatches": true,
    "batchContinuationAuthority": "user",
    "explicitContinueRequired": true
  },
  "audioPolicy": {
    "playbackRate": 1.1,
    "silenceThresholdDb": -35,
    "minimumLongPauseSeconds": 0.24,
    "retainedPauseSeconds": 0.05,
    "loudnessTargetLufs": -16,
    "truePeakDbtp": -1.5,
    "loudnessRangeLra": 11,
    "outputSampleRateHz": 48000,
    "userOriginalMustRemainUntouched": true
  },
  "endHoldPolicy": {
    "minimumSeconds": 1.2,
    "targetSeconds": 1.3,
    "maximumSeconds": 1.5
  },
  "renderPolicy": {
    "codec": "h264",
    "crf": 18,
    "backgroundMusic": false,
    "subtitles": false
  }
}
